
@model EduCap.Models.Curso

@{
    ViewData["Title"] = "Eliminar curso";
}

<div class="container py-4">

    <!-- ENCABEZADO -->
    <div class="mb-4">

        <h1 class="fw-bold">
            Eliminar curso
        </h1>

        <p class="text-muted">
            Confirma si deseas eliminar el curso seleccionado.
        </p>

    </div>

    <!-- TARJETA DE CONFIRMACIÓN -->
    <div class="card border shadow-sm rounded-4">

        <div class="card-body p-4 p-md-5">

            <div class="alert alert-warning mb-4">

                <strong>¡Atención!</strong>

                Estás a punto de eliminar un curso.
                Esta acción no se puede deshacer.

            </div>

            <h5 class="fw-bold mb-4">
                Información del curso
            </h5>

            <div class="row g-3">

                <div class="col-md-6">
                    <p class="text-muted small mb-1">
                        Nombre del curso
                    </p>

                    <p class="fw-semibold">
                        @(string.IsNullOrWhiteSpace(Model?.Nombre)
                            ? "Pendiente de cargar"
                            : Model.Nombre)
                    </p>
                </div>

                <div class="col-md-6">
                    <p class="text-muted small mb-1">
                        Categoría
                    </p>

                    <p class="fw-semibold">
                        @(string.IsNullOrWhiteSpace(Model?.Categoria)
                            ? "Pendiente de cargar"
                            : Model.Categoria)
                    </p>
                </div>

                <div class="col-md-6">
                    <p class="text-muted small mb-1">
                        Duración
                    </p>

                    <p class="fw-semibold">
                        @(Model != null && Model.DuracionHoras > 0
                            ? $"{Model.DuracionHoras} horas"
                            : "Pendiente de cargar")
                    </p>
                </div>

                <div class="col-md-6">
                    <p class="text-muted small mb-1">
                        Modalidad
                    </p>

                    <p class="fw-semibold">
                        @(string.IsNullOrWhiteSpace(Model?.Modalidad)
                            ? "Pendiente de cargar"
                            : Model.Modalidad)
                    </p>
                </div>

                <div class="col-md-6">
                    <p class="text-muted small mb-1">
                        Cupos disponibles
                    </p>

                    <p class="fw-semibold">
                        @(Model != null && Model.Cupos > 0
                            ? Model.Cupos.ToString()
                            : "Pendiente de cargar")
                    </p>
                </div>

                <div class="col-md-6">
                    <p class="text-muted small mb-1">
                        Fecha de inicio
                    </p>

                    <p class="fw-semibold">
                        @(Model != null &&
                          Model.FechaInicio != default(DateTime)
                            ? Model.FechaInicio.ToString("dd/MM/yyyy")
                            : "Pendiente de cargar")
                    </p>
                </div>

            </div>

            <hr class="my-4" />

            <!-- FORMULARIO DE ELIMINACIÓN -->
            <form asp-controller="Cursos"
                  asp-action="Eliminar"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div class="d-flex flex-wrap gap-3 justify-content-end">

                    <a asp-controller="Cursos"
                       asp-action="Administrar"
                       class="btn btn-outline-secondary px-4">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-danger px-4"
                            disabled>
                        Confirmar eliminación
                    </button>

                </div>

            </form>

            <p class="text-muted small text-end mt-3 mb-0">
                La eliminación se habilitará cuando
                el Backend esté conectado.
            </p>

        </div>

    </div>

</div>
