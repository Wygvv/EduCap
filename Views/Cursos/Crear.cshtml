
@model EduCap.Models.Curso

@{
    ViewData["Title"] = "Agregar curso";
}

<div class="container py-4">

    <!-- ENCABEZADO -->
    <div class="mb-4">

        <h1 class="fw-bold">
            Agregar nuevo curso
        </h1>

        <p class="text-muted">
            Completa la información para registrar
            una nueva capacitación en EduCap.
        </p>

    </div>

    <!-- FORMULARIO -->
    <div class="card border shadow-sm rounded-4">

        <div class="card-body p-4 p-md-5">

            <form asp-controller="Cursos"
                  asp-action="Crear"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-4">

                    <!-- NOMBRE -->
                    <div class="col-md-6">

                        <label asp-for="Nombre"
                               class="form-label fw-semibold">
                            Nombre del curso
                        </label>

                        <input asp-for="Nombre"
                               class="form-control"
                               placeholder="Ej: Computación básica" />

                        <span asp-validation-for="Nombre"
                              class="text-danger small"></span>

                    </div>

                    <!-- CATEGORÍA -->
                    <div class="col-md-6">

                        <label asp-for="Categoria"
                               class="form-label fw-semibold">
                            Categoría
                        </label>

                        <select asp-for="Categoria"
                                class="form-select">

                            <option value="">
                                Selecciona una categoría
                            </option>

                            <option value="Computación">
                                Computación
                            </option>

                            <option value="Programación">
                                Programación
                            </option>

                            <option value="Cocina">
                                Cocina
                            </option>

                            <option value="Coctelería">
                                Coctelería
                            </option>

                            <option value="Música">
                                Música
                            </option>

                            <option value="Arte">
                                Arte
                            </option>

                            <option value="Otros">
                                Otros
                            </option>

                        </select>

                        <span asp-validation-for="Categoria"
                              class="text-danger small"></span>

                    </div>

                    <!-- DESCRIPCIÓN -->
                    <div class="col-12">

                        <label asp-for="Descripcion"
                               class="form-label fw-semibold">
                            Descripción del curso
                        </label>

                        <textarea asp-for="Descripcion"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Describe los contenidos y objetivos del curso"></textarea>

                        <span asp-validation-for="Descripcion"
                              class="text-danger small"></span>

                    </div>

                    <!-- DURACIÓN -->
                    <div class="col-md-6">

                        <label asp-for="DuracionHoras"
                               class="form-label fw-semibold">
                            Duración (horas)
                        </label>

                        <input asp-for="DuracionHoras"
                               type="number"
                               min="1"
                               max="1000"
                               class="form-control" />

                        <span asp-validation-for="DuracionHoras"
                              class="text-danger small"></span>

                    </div>

                    <!-- MODALIDAD -->
                    <div class="col-md-6">

                        <label asp-for="Modalidad"
                               class="form-label fw-semibold">
                            Modalidad
                        </label>

                        <select asp-for="Modalidad"
                                class="form-select">

                            <option value="">
                                Selecciona una modalidad
                            </option>

                            <option value="Presencial">
                                Presencial
                            </option>

                            <option value="Online">
                                Online
                            </option>

                            <option value="Híbrido">
                                Híbrido
                            </option>

                        </select>

                        <span asp-validation-for="Modalidad"
                              class="text-danger small"></span>

                    </div>

                    <!-- CUPOS -->
                    <div class="col-md-6">

                        <label asp-for="Cupos"
                               class="form-label fw-semibold">
                            Cupos disponibles
                        </label>

                        <input asp-for="Cupos"
                               type="number"
                               min="1"
                               max="1000"
                               class="form-control" />

                        <span asp-validation-for="Cupos"
                              class="text-danger small"></span>

                    </div>

                    <!-- FECHA DE INICIO -->
                    <div class="col-md-6">

                        <label asp-for="FechaInicio"
                               class="form-label fw-semibold">
                            Fecha de inicio
                        </label>

                        <input asp-for="FechaInicio"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="FechaInicio"
                              class="text-danger small"></span>

                    </div>

                </div>

                <hr class="my-4" />

                <!-- BOTONES -->
                <div class="d-flex flex-wrap gap-3 justify-content-end">

                    <a asp-controller="Cursos"
                       asp-action="Administrar"
                       class="btn btn-outline-secondary px-4">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4">
                        Guardar curso
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
