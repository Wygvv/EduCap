
@{
    ViewData["Title"] = "Inicio";
}

<section class="text-center py-5">
    <h1 class="display-4 fw-bold">
        Bienvenido a EduCap
    </h1>

    <p class="lead mt-3">
        Plataforma de Cursos y Capacitaciones
    </p>

    <p class="mt-3">
        Aprende nuevas habilidades y desarrolla
        tus conocimientos con nuestros cursos.
    </p>

    <a asp-controller="Cursos"
       asp-action="Index"
       class="btn btn-primary btn-lg mt-3">
        Explorar cursos
    </a>
</section>

<section class="row text-center mt-5">

    <div class="col-md-4 mb-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h4>Cursos variados</h4>
                <p>
                    Explora capacitaciones de
                    distintas áreas.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h4>Aprendizaje flexible</h4>
                <p>
                    Cursos presenciales,
                    online e híbridos.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h4>Desarrollo profesional</h4>
                <p>
                    Mejora tus habilidades
                    y conocimientos.
                </p>
            </div>
        </div>
    </div>

</section>
