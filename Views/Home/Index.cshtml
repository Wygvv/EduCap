
@{
    ViewData["Title"] = "Inicio";
}

<section class="bg-primary bg-gradient text-white text-center rounded-4 py-5 px-4 shadow-sm">

    <div class="py-4">
        <h1 class="display-4 fw-bold mb-3">
            Bienvenido a EduCap
        </h1>

        <p class="fs-4 mb-3">
            Tu plataforma de cursos y capacitaciones
        </p>

        <p class="lead mb-4">
            Aprende nuevas habilidades, fortalece tus
            conocimientos y prepárate para nuevas
            oportunidades profesionales.
        </p>

        <a asp-controller="Cursos"
           asp-action="Index"
           class="btn btn-light btn-lg fw-semibold px-4">
            Explorar cursos
        </a>
    </div>

</section>

<section class="text-center mt-5 mb-4">
    <h2 class="fw-bold">¿Por qué elegir EduCap?</h2>
    <p class="text-muted">
        Una plataforma diseñada para facilitar
        tu aprendizaje y desarrollo profesional.
    </p>
</section>

<section class="row g-4 mb-5">

    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm rounded-4">
            <div class="card-body text-center p-4">
                <div class="fs-1 mb-3">📚</div>
                <h4 class="fw-bold">Cursos variados</h4>
                <p class="text-muted">
                    Descubre capacitaciones en diferentes
                    áreas y amplía tus conocimientos.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm rounded-4">
            <div class="card-body text-center p-4">
                <div class="fs-1 mb-3">💻</div>
                <h4 class="fw-bold">Aprendizaje flexible</h4>
                <p class="text-muted">
                    Accede a cursos presenciales,
                    online e híbridos según tus necesidades.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm rounded-4">
            <div class="card-body text-center p-4">
                <div class="fs-1 mb-3">🎓</div>
                <h4 class="fw-bold">Desarrollo profesional</h4>
                <p class="text-muted">
                    Desarrolla nuevas competencias
                    y mejora tus oportunidades laborales.
                </p>
            </div>
        </div>
    </div>

</section>
